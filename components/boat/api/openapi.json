 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {
   "Ok": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     }
    }
   },
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "request_id": {
        "type": "string"
       }
      }
     }
    }
   },
   "Scope": {
    "enum": [
     "vms:read",
     "vms:write",
     "exec",
     "admin"
    ]
   },
   "Size": {
    "type": "string",
    "description": "A size name from the server's boatd config (default: small, default, large, xlarge); omitted = the server's defaultSize"
   },
   "VM": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "size": {
      "$ref": "#/components/schemas/Size"
     },
     "image": {
      "type": "string"
     },
     "team": {
      "type": "string"
     },
     "state": {
      "enum": [
       "creating",
       "running",
       "stopping",
       "stopped",
       "starting",
       "forking",
       "error"
      ]
     },
     "labels": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "ports": {
      "type": "array",
      "items": {
       "type": "object"
      }
     }
    }
   },
   "CreateVM": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "size": {
      "$ref": "#/components/schemas/Size"
     },
     "image": {
      "type": "string"
     },
     "ttl_s": {
      "type": "integer"
     },
     "idle_stop_s": {
      "type": "integer",
      "description": "Auto-stop after this many idle seconds; -1 = never; 0 = server default"
     },
     "snapshot": {
      "type": "string",
      "description": "Create the VM from this snapshot (same team) instead of an image"
     },
     "labels": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "env": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "secrets": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "team secret names injected into this VM (absent = all team secrets, [] = none). Forks inherit the selection."
     }
    }
   },
   "Exec": {
    "type": "object",
    "properties": {
     "cmd": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "env": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "cwd": {
      "type": "string"
     },
     "stdin_b64": {
      "type": "string"
     },
     "timeout_s": {
      "type": "integer"
     }
    },
    "required": [
     "cmd"
    ]
   },
   "Prompt": {
    "type": "object",
    "properties": {
     "prompt": {
      "type": "string"
     },
     "agent": {
      "enum": [
       "claude",
       "codex",
       "opencode"
      ],
      "default": "claude"
     },
     "model": {
      "type": "string"
     },
     "cwd": {
      "type": "string"
     },
     "timeout_s": {
      "type": "integer"
     }
    },
    "required": [
     "prompt"
    ]
   },
   "ExecEvent": {
    "type": "object",
    "properties": {
     "stream": {
      "enum": [
       "stdout",
       "stderr"
      ]
     },
     "data_b64": {
      "type": "string"
     },
     "exit": {
      "type": "integer"
     }
    }
   },
   "SSH": {
    "type": "object",
    "properties": {
     "host": {
      "type": "string"
     },
     "port": {
      "type": "integer"
     },
     "user": {
      "type": "string"
     },
     "jump": {
      "type": "string"
     }
    }
   },
   "Me": {
    "type": "object",
    "properties": {
     "user": {
      "type": "object"
     },
     "team": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      }
     },
     "role": {
      "type": "string"
     },
     "scopes": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Scope"
      }
     },
     "key_id": {
      "type": "string"
     },
     "operator": {
      "type": "boolean"
     }
    }
   },
   "Team": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "members": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "user_id": {
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       }
      }
     },
     "created": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Key": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "user_id": {
      "type": "string"
     },
     "team_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "scopes": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Scope"
      }
     },
     "created": {
      "type": "string",
      "format": "date-time"
     },
     "token": {
      "type": "string",
      "description": "only in the create response"
     }
    }
   },
   "Webhook": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "events": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "created": {
      "type": "string",
      "format": "date-time"
     },
     "secret": {
      "type": "string",
      "description": "only in the create response"
     }
    }
   },
   "Delivery": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "webhook_id": {
      "type": "string"
     },
     "event_id": {
      "type": "string"
     },
     "event": {
      "type": "string"
     },
     "attempt": {
      "type": "integer"
     },
     "status": {
      "type": "integer"
     },
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     },
     "at": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "PortURL": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string"
     },
     "auth": {
      "enum": [
       "private",
       "public"
      ]
     },
     "guest_port": {
      "type": "integer"
     },
     "expires_at": {
      "type": "string",
      "format": "date-time"
     },
     "token": {
      "type": "string",
      "description": "<exp>.<sig>, for the X-Boat-Route-Token header"
     }
    }
   }
  },
  "responses": {
   "Error": {
    "description": "Error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 }
}
