{
 "openapi": "3.1.0",
 "info": {
  "title": "Boat API",
  "version": "1.0.0",
  "description": "Persistent Ubuntu VMs for AI agents. Auth: Authorization: Bearer boat_<id>_<secret>. Each operation lists its required scope in x-boat-scope. Webhooks are signed: X-Boat-Signature: t=<unix>,v1=hex(HMAC-SHA256(secret, t + '.' + body))."
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "paths": {
  "/healthz": {
   "get": {
    "summary": "Liveness",
    "security": [],
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/v1/openapi.json": {
   "get": {
    "summary": "This document",
    "security": [],
    "responses": {
     "200": {
      "description": "OpenAPI 3.1"
     }
    }
   }
  },
  "/v1/me": {
   "get": {
    "summary": "Caller identity, team, role and effective scopes",
    "responses": {
     "200": {
      "description": "OK",
