# Merged on top of Firecracker's microvm-kernel-ci-x86_64-6.1.config.
# build.sh fails if any of these is not =y in the final .config.
# The Firecracker CI config already has: virtio-net/blk/vsock, overlayfs,
# fuse, cgroups v2 (memcg, pids, cpuset, bpf, devices, blkio, cfs bw),
# namespaces, seccomp, bridge + br_netfilter, veth, vxlan, iptables/nft NAT,
# xt addrtype/conntrack/MASQUERADE, IP_PNP. KVM is not set (no nested VMs).
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_NFCT=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_MISC=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_SECURITY=y
CONFIG_KEYS=y
CONFIG_TMPFS_XATTR=y
# Fork safety: Firecracker >= 1.10 exposes a VMGenID ACPI device on x86_64
# (1.17 fixed its HID so the 6.1 driver binds). On restore the driver mixes
# the new generation ID into the CRNG (add_vmfork_randomness). Required.
CONFIG_ACPI=y
CONFIG_VMGENID=y
# Density: the balloon gives free guest pages back to the host (free page
# reporting), deflates on guest OOM. Firecracker's CI config has no balloon.
CONFIG_MEMORY_BALLOON=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
