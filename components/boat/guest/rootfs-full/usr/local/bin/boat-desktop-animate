#!/bin/bash
# Keep the desktop busy for N seconds so a stream fps measurement means something.
#   boat-desktop-animate [SECONDS=10] [full|small]
# full: glxgears over the whole screen on Mesa llvmpipe, a 1080p worst case.
# small: a 400x400 window, more like normal desktop use.
# Falls back to an xdotool-moved window if GL is unavailable. Prints the source's
# own frame rate, because a slow source would otherwise look like a slow stream.
set -u
secs=${1:-10}
mode=${2:-full}
export DISPLAY=${DISPLAY:-:1} vblank_mode=0
if [ "$mode" = full ]; then geom=(-fullscreen); else geom=(-geometry 400x400+100+100); fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT
timeout "$secs" stdbuf -oL glxgears "${geom[@]}" >"$log" 2>&1 &
gears=$!
sleep 1
if kill -0 "$gears" 2>/dev/null; then
  wait "$gears"
  echo "animate: glxgears $mode, $(grep 'frames in' "$log" | tail -1)"
  exit 0
fi

echo "animate: glxgears unavailable, moving a window with xdotool"
xfce4-terminal --geometry 40x10+0+0 --title boat-animate --hold -x true &
term=$!
for _ in $(seq 50); do
  win=$(xdotool search --name boat-animate 2>/dev/null | head -1) && [ -n "$win" ] && break
  sleep 0.1
done
end=$(( $(date +%s) + secs - 1 ))
x=0
while [ "$(date +%s)" -lt "$end" ]; do
  x=$(( (x + 8) % 1200 ))
  xdotool windowmove "$win" "$x" 200
  sleep 0.016
done
kill "$term" 2>/dev/null
