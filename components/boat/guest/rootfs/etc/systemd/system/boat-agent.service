[Unit]
Description=boat guest agent (JSON lines on vsock port 1024)
After=local-fs.target systemd-udevd.service
Wants=systemd-udevd.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/boat/boat-agent.py
Restart=always
RestartSec=1
# Killing the agent must not kill exec'd jobs or the desktop.
KillMode=process

[Install]
WantedBy=multi-user.target
