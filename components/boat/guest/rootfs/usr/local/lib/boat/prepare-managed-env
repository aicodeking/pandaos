#!/usr/bin/python3 -I
"""Install the managed-env compatibility link without reading legacy contents."""
import argparse
import os
from pathlib import Path
import stat

BOAT_DIR = Path("/etc/boat")
RUN_DIR = Path("/run")
MOUNTINFO = Path("/proc/self/mountinfo")
ROOT_UID = 0
ROOT_GID = 0


def root_directory(path):
    path.mkdir(mode=0o755, exist_ok=True)
    st = path.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != ROOT_UID:
        raise RuntimeError("managed env requires a root-owned directory: %s" % path)
    os.chown(path, ROOT_UID, ROOT_GID)
    path.chmod(0o755)


def prepare(image_setup=False):
    root_directory(BOAT_DIR)
    env = BOAT_DIR / "env"
    runtime_dir = RUN_DIR / "boat"
    runtime_env = runtime_dir / "env"
    # Never parse/source/copy the legacy managed file, including a partial write.
    (BOAT_DIR / "env.boat-tmp").unlink(missing_ok=True)
    if not (env.is_symlink() and os.readlink(env) == str(runtime_env)):
        env.unlink(missing_ok=True)
        env.symlink_to(runtime_env)
    if image_setup:
        # A Docker build's /run is an overlay, not the boot-time tmpfs.
        return
    mounts = [line.split() for line in MOUNTINFO.read_text().splitlines()]
    if not any(fields[4] == str(RUN_DIR) and
               fields[fields.index("-") + 1] == "tmpfs" for fields in mounts):
        raise RuntimeError("managed env requires /run mounted as tmpfs")
    root_directory(runtime_dir)
    if runtime_dir.stat().st_dev != RUN_DIR.stat().st_dev:
        raise RuntimeError("managed env directory must be on the /run tmpfs")
    # Idempotent within one boot: restarting this unit must not erase a fresh push.


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--image-setup", action="store_true",
                        help="discard legacy file/install link during an offline image build")
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("must run as root")
    prepare(image_setup=args.image_setup)
