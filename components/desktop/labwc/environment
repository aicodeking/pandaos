# Panda session environment, read by labwc at start (see labwc-config(5)).
# Fixed, predictable visuals and input for people and computer-use agents.

# Keyboard: US layout, no extra options.
XKB_DEFAULT_LAYOUT=us

# Cursor: one fixed theme and size (Adwaita ships with pcmanfm's closure).
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24

# Scale 1 everywhere, no toolkit auto-scaling.
GDK_SCALE=1
GDK_DPI_SCALE=1
QT_SCALE_FACTOR=1
QT_AUTO_SCREEN_SCALE_FACTOR=0
QT_ENABLE_HIGHDPI_SCALING=0

# GTK: dark Adwaita (built into GTK 3), always-visible scrollbars.
GTK_THEME=Adwaita:dark
GTK_OVERLAY_SCROLLING=0

# Accessibility: Qt apps join the AT-SPI bus. GTK_A11Y and NO_AT_BRIDGE are
# deliberately unset (services.gnome.at-spi2-core is on).
QT_ACCESSIBILITY=1
QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
