#!/bin/sh
# Panda repair menu (fuzzel dmenu). Each action opens in foot so output stays visible.
sudo=/run/wrappers/bin/sudo
snapdir=/.snapshots

# Run a command in a terminal that stays open after it exits.
term() {
  title=$1
  shift
  foot --hold --title "Panda: $title" "$@" &
}

# pick PROMPT: choose one line of stdin with fuzzel; fails on Escape.
pick() {
  fuzzel --dmenu --prompt "$1 "
}

# Yes/no prompt through fuzzel; succeeds only on "Yes".
confirm() {
  [ "$(printf 'No\nYes\n' | pick "$1?")" = "Yes" ]
}

updates() {
  case "$(printf '%s\n' Status "Run now" Hold Unhold | pick "updates>")" in
    "Status") term updates panda-update status ;;
    "Run now") confirm "Update the system now" && term updates "$sudo" panda-update run ;;
    "Hold") term updates "$sudo" panda-update hold ;;
    "Unhold") term updates "$sudo" panda-update unhold ;;
  esac
}

# Titles in fuzzel, chosen entry in a pager. Lines are "title | path".
memory() {
  if ! list=$(panda-mem list -limit 500 2>&1); then
    term memory echo "panda-mem list failed: $list"
    return 0
  fi
  entry=$(printf '%s\n' "$list" |
    jq -r '.[] | "\(.title // .path) | \(.path)"' | pick "memory>") || return 0
  # shellcheck disable=SC2016 # $1 expands in the inner sh, not here
  term memory sh -c 'panda-mem read "$1" | less' sh "${entry##* | }"
}

restore_mem() {
  snaps=$(find "$snapdir" -maxdepth 1 -name 'mem.*' -printf '%f\n' 2>/dev/null | sort -r)
  if [ -z "$snaps" ]; then
    term restore echo "No /mem snapshots in $snapdir."
    return 0
  fi
  snap=$(printf '%s\n' "$snaps" | pick "snapshot>") || return 0
  confirm "Replace /mem with $snap (current /mem is saved first)" &&
    term restore "$sudo" panda-rollback-mem "$snap"
}

# pick_ws: a workspace name from panda-ckpt; fails on Escape or none.
pick_ws() {
  if ! list=$(panda-ckpt list --json 2>&1); then
    term checkpoints echo "panda-ckpt list failed: $list"
    return 1
  fi
  names=$(printf '%s\n' "$list" | jq -r '.[].name')
  if [ -z "$names" ]; then
    term checkpoints echo "No workspaces yet. Create one: panda-ckpt init <name>"
    return 1
  fi
  printf '%s\n' "$names" | pick "workspace>"
}

# pick_ckpt WS: a checkpoint id of WS, newest first. Lines are "created reason label | id".
pick_ckpt() {
  entry=$(panda-ckpt list "$1" --json |
    jq -r 'reverse | .[] | "\(.created) \(.reason) \(.label // "") | \(.id)"' |
    pick "checkpoint>") || return 1
  printf '%s\n' "${entry##* | }"
}

checkpoints() {
  action=$(printf '%s\n' List Create Restore Fork | pick "checkpoints>") || return 0
  ws=$(pick_ws) || return 0
  case "$action" in
    "List") term checkpoints panda-ckpt list "$ws" ;;
    "Create") term checkpoints panda-ckpt create "$ws" -m "from menu" ;;
    "Restore")
      id=$(pick_ckpt "$ws") || return 0
      confirm "Restore $ws to $id (current state is checkpointed first)" &&
        term checkpoints panda-ckpt restore "$ws" "$id" ;;
    "Fork")
      id=$(pick_ckpt "$ws") || return 0
      name=$(printf '' | pick "new workspace name>") || return 0
      [ -n "$name" ] && term checkpoints panda-ckpt fork "$ws" "$id" "$name" ;;
  esac
}

connect() {
  case "$(printf '%s\n' "Sign in" Status Logs "Full access on" "Full access off" "Sign out" |
    pick "pandacode>")" in
    "Sign in") term pandacode panda-connect sign-in ;;
    "Status") term pandacode sh -c 'panda-connect status --json | jq .' ;;
    "Logs") term pandacode panda-connect logs ;;
    "Full access on")
      confirm "Give PandaCode agents full access to this machine" &&
        term pandacode panda-connect full-access on ;;
    "Full access off")
      confirm "Turn off full access for PandaCode agents" &&
        term pandacode panda-connect full-access off ;;
    "Sign out") confirm "Sign this device out of PandaCode" && term pandacode panda-connect sign-out ;;
  esac
}

choice=$(printf '%s\n' \
  "Network" \
  "Disks" \
  "Disk usage" \
  "Logs" \
  "Failed services" \
  "PandaCode Connect" \
  "Agents status" \
  "Agents doctor" \
  "Checkpoints" \
  "Memory browser" \
  "Restore /mem from snapshot" \
  "Updates" \
  "Roll back system" \
  "Lock screen" \
  "Reboot" \
  "Power off" | pick "panda>") || exit 0

case "$choice" in
  "Network") foot --title "Panda: network" nmtui & ;;
  "Disks") term disks sh -c 'lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS; echo; df -h' ;;
  "Disk usage") foot --title "Panda: ncdu" ncdu -x / & ;;
  "Logs") foot --title "Panda: logs" journalctl -f -n 200 & ;;
  "Failed services") term services systemctl --failed ;;
  "Agents status") term agents panda-agentd status ;;
  "Agents doctor") term agents panda-agents doctor ;;
  "Checkpoints") checkpoints ;;
  "PandaCode Connect") connect ;;
  "Memory browser") memory ;;
  "Restore /mem from snapshot") restore_mem ;;
  "Updates") updates ;;
  "Roll back system")
    # Hold first, so the next daily update does not undo the rollback.
    confirm "Roll back to the previous system and hold updates (Updates > Unhold to resume)" &&
      term rollback "$sudo" sh -c 'panda-update hold && nixos-rebuild switch --rollback' ;;
  "Lock screen") panda-lock ;;
  "Reboot") confirm "Reboot" && systemctl reboot ;;
  "Power off") confirm "Power off" && systemctl poweroff ;;
esac
