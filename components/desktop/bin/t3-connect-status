#!/bin/sh
# Waybar custom module: one JSON line from `t3-connect status --json`.
# `t3-connect-status click` is the module's on-click: show logs when enabled,
# start a signed-in but stopped host, else sign in.
# T3_CONNECT_CMD is only overridden by the fixture test.
cli=${T3_CONNECT_CMD:-t3-connect}

if [ "${1:-}" = click ]; then
  st=$("$cli" status --json 2>/dev/null || true)
  if printf '%s' "$st" | jq -e '.enabled == true' >/dev/null 2>&1; then
    exec foot --hold --title 'Panda: T3 Code logs' "$cli" logs
  fi
  if printf '%s' "$st" | jq -e '.signedIn == true' >/dev/null 2>&1; then
    exec foot --hold --title 'Panda: T3 Code start' "$cli" start
  fi
  exec foot --hold --title 'Panda: T3 Code sign-in' "$cli" sign-in
fi

if ! command -v "$cli" >/dev/null 2>&1; then
  printf '%s\n' '{"text":"T3: off","tooltip":"t3-connect is not installed","class":"off"}'
  exit 0
fi

# Don't trust the exit code: a disabled host may still print valid JSON.
out=$("$cli" status --json 2>/dev/null || true)
res=$(printf '%s' "$out" | jq -c '
  if type != "object" then error("not an object") else . end
  | "version: \(.version // "-")" as $v
  | "\(.host // "-"):\(.port // "-")" as $addr
  | if .enabled != true and .signedIn == true then
      {text: "T3: stopped", class: "off",
       tooltip: "\($v)\nSigned in to T3 Code Connect but stopped. Click to start"}
    elif .enabled != true then
      {text: "T3: sign in", class: "off", tooltip: "\($v)\nClick to sign in to T3 Code Connect"}
    elif .service == "failed" then
      {text: "T3: error", class: "failed", tooltip: "\($v)\nThe T3 Code host failed. Click for logs"}
    elif .service == "activating" then
      {text: "T3: starting", class: "connecting", tooltip: "\($v)\nStarting the T3 Code host. Click for logs"}
    elif .service == "active" and .signedIn == true then
      {text: "T3: connected", class: "active",
       tooltip: "\($v)\nConnected (mode: \(.mode // "-")) on \($addr). Click for logs"}
    elif .service == "active" and .mode == "local" then
      {text: "T3: local", class: "active",
       tooltip: "\($v)\nServing locally on \($addr), not signed in. Click for logs"}
    else
      {text: "T3: stopped", class: "off", tooltip: "\($v)\nservice: \(.service // "-"). Click for logs"}
    end
' 2>/dev/null || true)

if [ -n "$res" ]; then
  printf '%s\n' "$res"
else
  printf '%s\n' '{"text":"T3: ?","tooltip":"t3-connect status --json gave no valid JSON. Click for logs","class":"failed"}'
fi
