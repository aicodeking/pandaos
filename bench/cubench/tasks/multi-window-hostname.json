{
  "id": "multi-window-hostname",
  "title": "Multi-window: terminal to editor",
  "instruction": "Several windows are open. Use the terminal to find this computer's hostname, then type the hostname in the text editor and save it as ~/bench/host.txt.",
  "gui_only": false,
  "setup": [
    "audit_start",
    "launch files \"$B\"",
    "launch editor",
    "launch terminal"
  ],
  "verify": "[ -s \"$B/host.txt\" ] && [ \"$(tr -d ' \\n' < \"$B/host.txt\")\" = \"$(cat /proc/sys/kernel/hostname)\" ] && audit editor \"$B/host.txt\"",
  "oracle": [
    [
      "key",
      "alt+Tab"
    ],
    [
      "wait",
      1.5
    ],
    [
      "type",
      "{HOSTNAME}"
    ],
    [
      "key",
      "ctrl+s"
    ],
    [
      "wait",
      2.5
    ],
    [
      "save_as",
      "{HOME}/bench/host.txt"
    ]
  ],
  "timeout_s": 420,
  "max_steps": 30,
  "enforced": "host.txt is written by the editor (fanotify writer audit)",
  "cheat": [
    [
      "sh",
      "cat /proc/sys/kernel/hostname > \"$B/host.txt\""
    ],
    [
      "sh_try",
      "printf \"1\\tmousepad\\tclose_write\\t$B/host.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tgnome-text-edit\\tclose_write\\t$B/host.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tpcmanfm\\tclose_write\\t$B/host.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tnautilus\\tclose_write\\t$B/host.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tthunar\\tclose_write\\t$B/host.txt\\n\" >> \"$AUDIT_LOG\""
    ]
  ]
}
