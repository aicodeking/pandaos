{
  "id": "editor-new-file",
  "title": "Text editor: write and save a new file",
  "instruction": "In the text editor, type exactly the text `hello cubench` and save the document as ~/bench/hello.txt.",
  "gui_only": true,
  "setup": [
    "audit_start",
    "launch editor"
  ],
  "verify": "[ \"$(cat \"$B/hello.txt\")\" = \"hello cubench\" ] && audit editor \"$B/hello.txt\"",
  "oracle": [
    [
      "type",
      "hello cubench"
    ],
    [
      "key",
      "ctrl+s"
    ],
    [
      "wait",
      2.5
    ],
    [
      "save_as",
      "{HOME}/bench/hello.txt"
    ]
  ],
  "timeout_s": 300,
  "max_steps": 20,
  "enforced": "the file is written by the editor process (fanotify writer audit), not by a shell",
  "cheat": [
    [
      "sh",
      "printf 'hello cubench\\n' > \"$B/hello.txt\""
    ],
    [
      "sh_try",
      "printf \"1\\tmousepad\\tclose_write\\t$B/hello.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tgnome-text-edit\\tclose_write\\t$B/hello.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tpcmanfm\\tclose_write\\t$B/hello.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tnautilus\\tclose_write\\t$B/hello.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tthunar\\tclose_write\\t$B/hello.txt\\n\" >> \"$AUDIT_LOG\""
    ]
  ]
}
