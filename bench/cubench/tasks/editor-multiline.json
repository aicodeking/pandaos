{
  "id": "editor-multiline",
  "title": "Text editor: three lines in order",
  "instruction": "In the text editor, write these three lines in this order, one per line and nothing else: alpha, beta, gamma. Save the document as ~/bench/greek.txt.",
  "gui_only": true,
  "setup": [
    "audit_start",
    "launch editor"
  ],
  "verify": "[ \"$(cat \"$B/greek.txt\")\" = \"$(printf 'alpha\\nbeta\\ngamma')\" ] && audit editor \"$B/greek.txt\"",
  "oracle": [
    [
      "type",
      "alpha\nbeta\ngamma"
    ],
    [
      "key",
      "ctrl+s"
    ],
    [
      "wait",
      2.5
    ],
    [
      "save_as",
      "{HOME}/bench/greek.txt"
    ]
  ],
  "timeout_s": 300,
  "max_steps": 20,
  "enforced": "the file is written by the editor process (fanotify writer audit), not by a shell",
  "cheat": [
    [
      "sh",
      "printf 'alpha\\nbeta\\ngamma\\n' > \"$B/greek.txt\""
    ],
    [
      "sh_try",
      "printf \"1\\tmousepad\\tclose_write\\t$B/greek.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tgnome-text-edit\\tclose_write\\t$B/greek.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tpcmanfm\\tclose_write\\t$B/greek.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tnautilus\\tclose_write\\t$B/greek.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tthunar\\tclose_write\\t$B/greek.txt\\n\" >> \"$AUDIT_LOG\""
    ]
  ]
}
