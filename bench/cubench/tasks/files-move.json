{
  "id": "files-move",
  "title": "File manager: move a file into another folder",
  "instruction": "The file manager shows the folder ~/bench/inbox. Move the file report-2026.txt from there into the folder ~/bench/archive.",
  "gui_only": true,
  "setup": [
    "mkdir \"$B/archive\" \"$B/inbox\"",
    "echo report > \"$B/inbox/report-2026.txt\"",
    "audit_start",
    "launch files \"$B/inbox\""
  ],
  "verify": "[ -f \"$B/archive/report-2026.txt\" ] && [ ! -e \"$B/inbox/report-2026.txt\" ] && audit files \"$B/archive/report-2026.txt\"",
  "oracle": [
    [
      "os_click",
      "files_focus"
    ],
    [
      "key",
      "ctrl+a"
    ],
    [
      "key",
      "ctrl+x"
    ],
    [
      "key",
      "ctrl+l"
    ],
    [
      "wait",
      1
    ],
    [
      "type",
      "{HOME}/bench/archive\n"
    ],
    [
      "wait",
      2
    ],
    [
      "os_click",
      "files_focus"
    ],
    [
      "key",
      "ctrl+v"
    ],
    [
      "wait",
      2
    ]
  ],
  "timeout_s": 300,
  "max_steps": 25,
  "enforced": "the change is made by the file manager process (fanotify writer audit), not by a shell",
  "cheat": [
    [
      "sh",
      "mv \"$B/inbox/report-2026.txt\" \"$B/archive/\""
    ],
    [
      "sh_try",
      "printf \"1\\tmousepad\\tclose_write\\t$B/archive/report-2026.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tgnome-text-edit\\tclose_write\\t$B/archive/report-2026.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tpcmanfm\\tclose_write\\t$B/archive/report-2026.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tnautilus\\tclose_write\\t$B/archive/report-2026.txt\\n\" >> \"$AUDIT_LOG\""
    ],
    [
      "sh_try",
      "printf \"1\\tthunar\\tclose_write\\t$B/archive/report-2026.txt\\n\" >> \"$AUDIT_LOG\""
    ]
  ]
}
