{
  "id": "settings-browser-homepage",
  "title": "Settings: change an app preference",
  "instruction": "In the web browser's settings, set the home page to the custom URL http://127.0.0.1:8000/home.html.",
  "setup": [
    "serve_form",
    "LAUNCH_WAIT=12 launch browser http://127.0.0.1:8000/form.html"
  ],
  "verify": "pkill -TERM -u \"$(id -u)\" -f firefox; sleep 5; grep -rqsE 'browser\\.startup\\.homepage\", \"http://127\\.0\\.0\\.1:8000/home\\.html/?\"' ~/.mozilla ~/.config/mozilla",
  "timeout_s": 420,
  "max_steps": 30
}
